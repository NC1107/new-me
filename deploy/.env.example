DOMAIN=npc-server.top
TZ=America/New_York

# Postgres (used by the db container and the server's connection string)
POSTGRES_USER=newme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newme

# Shared secret baked into the iPhone build. Requests without it are rejected.
# Generate with: openssl rand -base64 32
NEWME_APP_KEY=change-me

# Name shown in the app's server picker
NEWME_SERVER_NAME=New Me

# Optional: base URL of Audiobookshelf. Set it to count audiobook listening toward the reading
# quest; people link their account in Me. Empty turns the feature off.
# NEWME_ABS_URL=https://books.npc-server.top

# Optional: Apple push notifications. Set all four or none. The key is the contents of the .p8
# file, base64 encoded on one line (base64 -w0 AuthKey_XXXX.p8). Production is true for
# TestFlight and App Store builds.
# NEWME_APNS_KEY=
# NEWME_APNS_KEY_ID=
# NEWME_APNS_TEAM_ID=76S78SUWVM
# NEWME_APNS_TOPIC=top.npcserver.newme
# NEWME_APNS_PRODUCTION=true

# Optional: pin a released image tag (rollback = set this to the previous X.Y.Z and docker compose up -d)
# NEWME_TAG=0.1.0
