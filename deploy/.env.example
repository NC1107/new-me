DOMAIN=npc-server.top
TZ=America/New_York

# Postgres (used by the db container and the server's connection string)
POSTGRES_USER=newme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newme

# Shared secret baked into the iPhone build. Requests without it are rejected.
# Generate with: openssl rand -base64 32
NEWME_APP_KEY=change-me

# Name shown in the app's server picker
NEWME_SERVER_NAME=New Me

# Optional: pin a released image instead of :latest
# NEWME_IMAGE=ghcr.io/nc1107/new-me:0.1.0
